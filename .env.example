# Copy this file to .env and set your own values. Never commit .env.
# SQL Server (Docker) requires a strong SA password:
# at least 8 chars, with upper, lower, digit and symbol.

MSSQL_SA_PASSWORD=Change_me_Str0ng!Pass
MSSQL_PID=Developer

# Connection string used by the API (Phase 2). Filled with placeholders.
# Docker:
CONNECTION_STRING=Server=localhost,1433;Database=InventoryDemo;User Id=sa;Password=Change_me_Str0ng!Pass;TrustServerCertificate=True;Encrypt=True
# LocalDB (Windows, no Docker):
# CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=InventoryDemo;Integrated Security=True;TrustServerCertificate=True
